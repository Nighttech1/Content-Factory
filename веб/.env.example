# Content Factory — env template. Copy to `.env` and fill locally / on the VPS.
# НИКОГДА не коммить реальные значения (реальный .env в .gitignore).

# --- Database (Prisma / Postgres). Absent → JSON fallback in data/local/ ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/content_factory?schema=public"

# --- Queue / Redis (optional; adapters mock without it) ---
# REDIS_URL="redis://localhost:6379"

# --- LLM aggregator (Polza AI, OpenAI-compatible) ---
AGGREGATOR_API_KEY=
AGGREGATOR_BASE_URL=https://polza.ai/api/v1
AGGREGATOR_DEFAULT_MODEL=openai/gpt-4o

# --- Carousel pipeline models ---
CAROUSEL_IMAGE_MODEL=openai/gpt-5.4-image-2
CAROUSEL_MODEL_ORCHESTRATOR=openai/gpt-4o
CAROUSEL_MODEL_AD_FINAL=anthropic/claude-sonnet-4
CAROUSEL_MODEL_AD_SCRIPT=anthropic/claude-sonnet-4
CAROUSEL_SCRIPTWRITER_MODEL=anthropic/claude-sonnet-4
ART_DIRECTOR_MODEL=anthropic/claude-sonnet-4

# --- Instagram / scraper (optional) ---
IG_USER_ID=
IG_OURS_USERNAME=
IG_ACCESS_TOKEN=
IG_SCRAPER_API_KEY=

# --- HeyGen (optional; empty → mock) ---
HEYGEN_API_KEY=

# --- Media / render ---
ENABLE_REMOTION_RENDER=0

# --- 21st.dev UI catalog (Frontend MCP) ---
# API_KEY_21ST=
